# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Test / tooling caches
.pytest_cache/
.ruff_cache/

# Output artifacts (regenerated by the pipeline)
# NOTE: this only covers the repository-root output/. solution/output/ is committed on
# purpose -- it is the evidence a reviewer can open without running anything, and the
# dashboard's bundle is built from it.
output/*.db
output/*.json
output/*.csv

# Keep the placeholder
!output/.gitkeep

# Scratch file left by a filesystem write probe on a sync-backed mount that denies
# unlink. It has no content and no purpose; it is ignored rather than committed.
.writetest

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
.vercel
.env*

*.zip
